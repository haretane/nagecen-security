{
  "name": "nagecen-security-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "VITE_SECURITY_DEMO_ENABLED=true VITE_SECURITY_SUBMISSION_MODE=true VITE_SECURITY_ACCOUNT_LOGIN_ENABLED=true VITE_SECURITY_DIAGNOSTICS_PAUSED=true vite build --outDir dist-demo",
    "preview": "vite preview",
