# ローカル開発用の設定例です。
# このファイルを .env にコピーして、必要な場合だけ値を変更します。
POSTGRES_DB=nagecen_security
POSTGRES_USER=nagecen_security
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433

FRONTEND_PORT=5174
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173
SECURITY_FRONTEND_URL=http://localhost:5174
NAGECEN_FRONTEND_URL=http://localhost:5173/nagecen
NAGECEN_TO_SECURITY_KEY_ID=local-v1
NAGECEN_TO_SECURITY_HMAC_SECRET=replace_with_at_least_32_random_characters
SECURITY_TO_NAGECEN_KEY_ID=security-local-v1
SECURITY_TO_NAGECEN_HMAC_SECRET=replace_with_a_different_32_character_secret
NAGECEN_CALLBACK_URL=http://host.docker.internal:8080/api/security_callback.php
COOKIE_SECURE=false
APP_ENV=development
