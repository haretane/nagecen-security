# KAGOYA VPS本番環境用の設定見本です。
# このファイル自体には本物のパスワードや秘密値を保存しません。
# VPS上で .env.production を作り、replace_with_... の値をすべて置き換えます。

# 公開URL
PUBLIC_DOMAIN=nagecen-security.ucu4-lab.mydns.jp
SECURITY_FRONTEND_URL=https://nagecen-security.ucu4-lab.mydns.jp

# PostgreSQL
POSTGRES_DB=nagecen_security
POSTGRES_USER=nagecen_security
POSTGRES_PASSWORD=replace_with_random_database_password

# NAGeCen本体との連携
NAGECEN_FRONTEND_URL=https://ucu4.sakura.ne.jp/nagecen
NAGECEN_CALLBACK_URL=https://ucu4.sakura.ne.jp/nagecen/api/security_callback.php
CORS_ALLOWED_ORIGINS=https://nagecen-security.ucu4-lab.mydns.jp,https://ucu4.sakura.ne.jp

# NAGeCen本体からSecurityへの署名確認
NAGECEN_TO_SECURITY_KEY_ID=production-v1
NAGECEN_TO_SECURITY_HMAC_SECRET=replace_with_at_least_32_random_characters

# SecurityからNAGeCen本体への通知署名
SECURITY_TO_NAGECEN_KEY_ID=security-production-v1
SECURITY_TO_NAGECEN_HMAC_SECRET=replace_with_a_different_32_character_secret

# VPS上のdockerグループIDです。デプロイ時に実際の値を確認します。
DOCKER_GID=999
